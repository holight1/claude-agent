#!/bin/bash
# pre-commit hook: 检查私有信息泄露
# 通用模式：私网 IP、用户路径、SSH 凭据
# 私有项目名等从本地 config 读取（不追踪到公开仓库）

FAIL=0
staged_content=$(git diff --cached --unified=0 | grep "^+" | grep -v "^+++")

check_pattern() {
    local label="$1"
    local pattern="$2"
    local matches
    matches=$(echo "$staged_content" | grep -oP "$pattern" | sort -u)
    if [ -n "$matches" ]; then
        echo "  [$label] 发现疑似私有信息："
        echo "$matches" | sed 's/^/    /'
        FAIL=1
    fi
}

echo "🔍 检查私有信息..."

# ── 通用模式（公开 hook 中维护）──────────────────────────────────────────────

# 私网 IP
check_pattern "私网IP" '(?<![<\w])(192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})(?![>\w])'

# 真实用户名路径
check_pattern "用户路径" '/home/(?!(username|user|\$USER|<user>|YOUR_))[a-z][a-z0-9_-]{2,}/'

# SSH 用户@主机
check_pattern "SSH凭据" '(?<!\w)[a-z][a-z0-9]{2,}@(?!(hostname|host|remote|example|localhost|server)\b)[a-z][a-z0-9.-]{3,}'

# ── 私有项目/公司模式（从本地 config 读取，不追踪到仓库）────────────────────

PRIVATE_CONFIG="${HOME}/.claude/hooks/git/private-patterns.conf"
if [ -f "$PRIVATE_CONFIG" ]; then
    while IFS='|' read -r label pattern; do
        [[ -z "$label" || "$label" =~ ^# ]] && continue
        check_pattern "$label" "$pattern"
    done < "$PRIVATE_CONFIG"
fi

if [ $FAIL -eq 1 ]; then
    echo ""
    echo "❌ 提交被拦截：检测到疑似私有信息。"
    echo "   如果这是误报，请用 git commit --no-verify 强制提交。"
    exit 1
fi

echo "✅ 未发现私有信息，提交正常。"
exit 0
